ARG PYTHON_IMAGE=python:3.12-slim-bookworm
FROM ${PYTHON_IMAGE}
ARG PIP_INDEX_URL=https://pypi.org/simple
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 MICROBIND_DATA=/data MICROBIND_DEMO=/app/demo
COPY deploy/requirements.lock /app/requirements.lock
RUN pip install --no-cache-dir --index-url ${PIP_INDEX_URL} -r /app/requirements.lock
COPY pyproject.toml README.md LICENSE /app/
COPY src /app/src
COPY demo /app/demo
COPY samples /app/samples
RUN pip install --no-cache-dir --no-deps --no-build-isolation . \
    && mkdir -p /data && chown 10001:10001 /data
USER 10001:10001
CMD ["uvicorn", "microbind.server.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
