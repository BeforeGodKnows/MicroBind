COMPOSE_PROJECT_NAME=microbind
BIND_ADDRESS=127.0.0.1
WEB_PORT=18080
MICROBIND_AUTH_REQUIRED=1
MICROBIND_VERIFY_ENABLED=0
COMPOSE_PROFILES=
API_MEMORY=512m
API_CPUS=0.5
WORKER_MEMORY=1g
WORKER_CPUS=1.0
WEB_MEMORY=128m
WEB_CPUS=0.25
VERIFY_MEMORY=2g
VERIFY_CPUS=2.0
MICROBIND_JOB_TIMEOUT=1800
MICROBIND_LLM_ENABLED=0
MICROBIND_LLM_BASE_URL=
MICROBIND_LLM_MODEL=
MICROBIND_LLM_API_KEY=
MICROBIND_LLM_ALLOW_HTTP=0
MICROBIND_SMART_MAX_FINDINGS=8
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
MAVEN_REPOSITORY=https://repo.maven.apache.org/maven2
# Override with your organization's reachable registry images if needed.
PYTHON_IMAGE=python:3.12-slim-bookworm
NODE_IMAGE=node:24-bookworm-slim
NGINX_IMAGE=nginxinc/nginx-unprivileged:1.28-alpine
MAVEN_IMAGE=maven:3.9.9-eclipse-temurin-17
API_IMAGE=microbind-api:0.3.4
WEB_IMAGE=microbind-web:0.3.4
VERIFY_IMAGE=microbind-verify:0.3.4
